# Android 16 partition table for Xiaomi Mi MIX 2 (chiron).

/dev/block/bootdevice/by-name/boot      /boot                 emmc    defaults                                                         recoveryonly
/dev/block/bootdevice/by-name/recovery  /recovery             emmc    defaults                                                         recoveryonly
/dev/block/by-name/system               /system               ext4    ro,barrier=1                                                     wait,first_stage_mount
/dev/block/by-name/cust                 /vendor               erofs   ro                                                               wait,first_stage_mount
/dev/block/bootdevice/by-name/cache     /cache                ext4    nosuid,nodev,noatime,barrier=1                                   wait,check,formattable
/dev/block/bootdevice/by-name/cache     /cache                f2fs    nosuid,nodev,noatime,discard,fsync_mode=nobarrier                  wait,check,formattable
/dev/block/bootdevice/by-name/userdata  /data                 ext4    nosuid,nodev,noatime,barrier=1,noauto_da_alloc,errors=panic        wait,check,fileencryption=ice:aes-256-cts:v1,quota,reservedsize=128M
/dev/block/bootdevice/by-name/userdata  /data                 f2fs    nosuid,nodev,noatime,discard,fsync_mode=nobarrier                  wait,check,latemount,formattable,quota,reservedsize=128M
/dev/block/bootdevice/by-name/persist   /mnt/vendor/persist   ext4    nosuid,nodev,noatime,barrier=1                                   wait
/dev/block/bootdevice/by-name/dsp       /vendor/dsp           ext4    ro,nosuid,nodev,barrier=1                                        wait
/dev/block/bootdevice/by-name/modem     /vendor/firmware_mnt  vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337          wait
/dev/block/bootdevice/by-name/bluetooth /vendor/bt_firmware   vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337          wait
/dev/block/bootdevice/by-name/misc      /misc                 emmc    defaults                                                         defaults
/dev/block/bootdevice/by-name/splash    /splash               emmc    defaults                                                         defaults

/devices/soc/a800000.ssusb/a800000.dwc3/xhci-hcd.0.auto/usb* auto auto defaults voldmanaged=usb:auto
