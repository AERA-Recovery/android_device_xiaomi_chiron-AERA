+        static unsigned frames = 0;
+        total_copy += copied - begin;
+        total_flip += monotonic_ns() - copied;
+        if (++frames == 60) {
+            __android_log_print(ANDROID_LOG_INFO, "AeraFbdev",
+                "shared 60 frames: direct copy %.2f ms, flip wait %.2f ms",
+                total_copy / 60000000.0, total_flip / 60000000.0);
