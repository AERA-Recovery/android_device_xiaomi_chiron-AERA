--- /dev/null
+++ b/aeraui/core/legacy_mdss_abi.hpp
@@ -0,0 +1,61 @@
+/*
+ * Qualcomm MDSS atomic-display v1 userspace ABI subset.
+ * Layouts and constants correspond to include/uapi/linux/msm_mdp{,_ext}.h
+ * in xiaomi-msm8998-devs/android_kernel_xiaomi_msm8998 (lineage-24.0).
+ * These are kernel interface declarations, not an implementation of a driver.
+ */
+#pragma once
+#include <cstdint>
+#include <sys/ioctl.h>
+
+namespace aeraui::mdss {
+constexpr uint32_t kVersion = 0x00010000;
+constexpr uint32_t kValidate = 0x01;
+constexpr uint32_t kWaitForFinish = 0x02;
+constexpr uint32_t kRgba8888 = 13;
+constexpr uint32_t kOpaque = 1;
+constexpr unsigned long kAtomicCommit = _IOWR('S', 128, void*);
+struct Rect { uint32_t x, y, w, h; };
+struct Plane { int32_t fd; uint32_t offset, stride; };
+struct Buffer {
+  uint32_t width, height, format;
+  Plane planes[4];
+  uint32_t plane_count;
+  struct { uint32_t numer, denom; } comp_ratio;
+  int32_t fence;
+  uint32_t reserved;
+};
+struct InputLayer {
+  uint32_t flags, pipe_ndx;
+  uint8_t horz_deci, vert_deci, alpha;
+  uint16_t z_order;
+  uint32_t transp_mask, bg_color, blend_op, color_space;
+  Rect src_rect, dst_rect;
+  void* scale;
+  Buffer buffer;
+  void* pp_info;
+  int32_t error_code;
+  uint32_t rect_num, reserved[5];
+};
+struct CommitV1 {
+  uint32_t flags;
+  int32_t release_fence;
+  Rect left_roi, right_roi;
+  InputLayer* input_layers;
+  uint32_t input_layer_cnt;
+  void* output_layer;
+  int32_t retire_fence;
+  void* dest_scaler;
+  uint32_t dest_scaler_cnt, bl_level;
+#ifdef __LP64
+  // This spelling follows the vendor UAPI (not the usual __LP64__ macro).
+  uint32_t reserved[2];
+#else
+  uint32_t reserved[3];
+#endif
+};
+struct Commit { uint32_t version; CommitV1 v1; };
+#if INTPTR_MAX == INT64_MAX
+static_assert(sizeof(Commit) == 112, "MDSS v1 commit ABI mismatch");
+#endif
+} // namespace aeraui::mdss
