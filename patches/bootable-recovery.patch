@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace aeraui {
+// One continuous, antialiased silhouette. Independent triangle textures can
+// leave sampling seams when the logical canvas is scaled to a smaller panel.
+inline void RasterEdgeWave(uint32_t *pixels, int width, int height, int depth,
+                           bool right_edge, uint32_t rgb) {
+  if (!pixels || width <= 0 || height <= 0) return;
+  const double half = height * 0.5;
+  depth = std::clamp(depth, 0, width);
+  for (int y = 0; y < height; ++y) {
+    const double distance = (y + 0.5 - half) / half;
+    const double square = distance * distance;
+    const double extent = depth * (1.0 - square) * (1.0 - 0.25 * square);
+    for (int x = 0; x < width; ++x) {
+      const int inward = right_edge ? width - 1 - x : x;
+      const uint32_t alpha = static_cast<uint32_t>(
+          std::clamp(extent - inward, 0.0, 1.0) * 255.0 + 0.5);
+      pixels[y * width + x] = (alpha << 24) | (rgb & 0x00ffffff);
+    }
+  }
+}
+}  // namespace aeraui
