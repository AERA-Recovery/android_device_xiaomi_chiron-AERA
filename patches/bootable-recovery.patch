+static void present_external_frame() {
+    char profile_value[PROP_VALUE_MAX]{};
+    __system_property_get("debug.aera.gpu_profile", profile_value);
+    const bool profile = profile_value[0] == '1';
+    const uint64_t begin = profile ? monotonic_ns() : 0;
+    GRSurface& target = gr_framebuffer[1 - displayed_buffer];
+    const size_t bytes = static_cast<size_t>(target.width) * 4;
+    if (present_stride == target.row_bytes) {
+        memcpy(target.data, present_pixels, static_cast<size_t>(target.height) * target.row_bytes);
+    } else {
