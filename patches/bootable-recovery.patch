+            memcpy(target.data + static_cast<size_t>(y) * target.row_bytes,
+                   present_pixels + static_cast<size_t>(y) * present_stride, bytes);
+    }
+    const uint64_t copied = profile ? monotonic_ns() : 0;
+    set_displayed_framebuffer(1 - displayed_buffer);
+    external_frame = true;
+    if (profile) {
